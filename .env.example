# Copy this file to .env and fill in your values. NEVER share your .env file.

# --- Server ---
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://your-domain.com

# --- Database (MongoDB Atlas → Connect → Drivers → copy the URI) ---
MONGODB_URI=
MONGODB_DB=seedha_store

# --- Dashboard login (/admin) ---
ADMIN_USERNAME=menkartt
ADMIN_PASSWORD=choose-a-long-password
# Any long random text (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

# --- Razorpay (dashboard.razorpay.com → Account & Settings → API Keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → URL: https://your-domain.com/api/razorpay/webhook  (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# --- Meta Pixel (Events Manager → Data sources → Pixel ID). Optional but recommended for ads ---
META_PIXEL_ID=

# --- Business details (shown on the site & policy pages; Razorpay checks these) ---
STORE_NAME=Menkartt
BRAND_TAGLINE=Posture Corrector Belt for Men
BUSINESS_NAME=
SUPPORT_EMAIL=support.menkartt2@gmail.com
SUPPORT_PHONE=
WHATSAPP_NUMBER=
BUSINESS_ADDRESS=

# --- Offers ---
COD_ENABLED=true
